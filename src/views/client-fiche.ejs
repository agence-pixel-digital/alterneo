<%- include('partials/header', { title: fiche.societe || fiche.client || 'Fiche client', active: 'clients' }) %>

<%
  var fmt = K.formatEuro;
  var nom = fiche.societe || fiche.client || 'Client sans nom';
  var initiales = nom.split(/[\s'-]+/).filter(Boolean).slice(0, 2).map(function (m) { return m[0]; }).join('').toUpperCase();
  var COULEURS = ['#2E5C8A', '#7A53C1', '#1F8E5F', '#C2502E', '#B7791F', '#2A7F9E', '#8A4F7D'];
  var h = 0; for (var i = 0; i < nom.length; i++) h = (h * 31 + nom.charCodeAt(i)) >>> 0;
  var couleur = COULEURS[h % COULEURS.length];
  var abos = fiche.abonnements;
  var groupes = fiche.groupes;
  var totaux = fiche.totaux;
  var sitePrincipal = fiche.sites[0] || null;
  // Sérialisation sûre pour les attributs data-* (le modal de modification relit ces valeurs).
  var attr = function (v) { return v === null || v === undefined ? '' : String(v); };
%>

<a href="/clients" class="back-link">&larr; Retour aux clients</a>

<div class="card">
  <div class="client-hero">
    <div class="client-hero-avatar" style="background:<%= couleur %>;"><%= initiales %></div>
    <div class="client-hero-main">
      <div class="client-hero-top">
        <h2><%= nom %></h2>
        <% if (fiche.type_structure) { %><span class="badge badge-structure"><%= fiche.type_structure %></span><% } %>
      </div>
      <div class="client-hero-sub">
        <% if (fiche.societe && fiche.client && fiche.client !== fiche.societe) { %><span><%- ico('user', 15) %><%= fiche.client %></span><% } %>
        <% if (sitePrincipal) { %><a href="<%= K.urlSure(sitePrincipal) %>" target="_blank" rel="noopener noreferrer"><%- ico('globe', 15) %><%= sitePrincipal %><% if (fiche.sites.length > 1) { %> <span class="muted">+<%= fiche.sites.length - 1 %></span><% } %></a><% } %>
        <% if (fiche.stripe_customer_id) { %>
          <span class="stripe-pill on" title="<%= fiche.stripe_customer_id %>"><%- ico('card', 12) %>Client Stripe</span>
        <% } else { %>
          <span class="stripe-pill off">Hors Stripe</span>
        <% } %>
      </div>
      <% if (fiche.categories.length) { %>
        <div class="client-hero-badges">
          <% fiche.categories.forEach(function (k) { %>
            <span class="badge cat-<%= k %>"><%= K.CATEGORIE_LABEL[k] %></span>
          <% }); %>
        </div>
      <% } %>
    </div>
    <div class="client-hero-actions">
      <% if (fiche.lienStripe) { %>
        <a href="<%= fiche.lienStripe %>" target="_blank" rel="noopener noreferrer" class="btn btn-stripe" title="Ouvrir la fiche client dans le dashboard Stripe">
          <span style="margin-right:6px;display:inline-flex;"><%- ico('card', 15) %></span>Fiche Stripe
        </a>
      <% } %>
      <% if (fiche.lienMainWP) { %>
        <a href="<%= fiche.lienMainWP %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary"
          title="Ouvre le wp-admin du site via MainWP (session MainWP requise)">
          <span style="margin-right:6px;display:inline-flex;"><%- ico('zap', 15) %></span>Connexion en 1 clic
        </a>
      <% } %>
      <% if (isAdmin) { %>
        <button type="button" class="btn btn-outline" onclick="ouvrirModalModifierClient()">
          <span style="margin-right:6px;display:inline-flex;"><%- ico('pencil', 15) %></span>Modifier
        </button>
      <% } %>
    </div>
  </div>

  <div class="client-hero-stats">
    <div class="hero-stat">
      <div class="hero-stat-label">Abonnements</div>
      <div class="hero-stat-value"><%= groupes.length %><% if (abos.length !== groupes.length) { %><span class="hero-stat-unit"><%= abos.length %> produits</span><% } %></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-label">Sites / domaines</div>
      <div class="hero-stat-value"><%= fiche.sites.length %></div>
    </div>
    <%# Montants réservés à l'admin, toujours annualisés (mensuels × 12). %>
    <% if (isAdmin) { %>
      <div class="hero-stat">
        <div class="hero-stat-label">CA annuel estimé</div>
        <div class="hero-stat-value" style="color:#2E5C8A;"><%= totaux.caAnnuel ? fmt(totaux.caAnnuel) : '—' %><% if (totaux.caAnnuel) { %><span class="hero-stat-unit">/an</span><% } %></div>
      </div>
    <% } %>
  </div>
</div>

<div class="fiche-layout">
  <div>
    <div class="card">
      <div class="card-title">Coordonnées</div>

      <div class="contact-row">
        <div class="contact-icon ci-purple"><%- ico('user') %></div>
        <div class="contact-body">
          <div class="contact-label">Client (contact)</div>
          <% if (fiche.client) { %><div class="contact-value"><%= fiche.client %></div>
          <% } else { %><div class="contact-value vide">Non renseigné</div><% } %>
        </div>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-green"><%- ico('phone') %></div>
        <div class="contact-body">
          <div class="contact-label">Téléphone</div>
          <% if (fiche.telephone) { %>
            <div class="contact-value"><a href="tel:<%= fiche.telephone.replace(/[^\d+]/g, '') %>"><%= fiche.telephone %></a></div>
          <% } else { %><div class="contact-value vide">Non renseigné</div><% } %>
        </div>
        <% if (fiche.telephone) { %>
          <button type="button" class="icon-btn js-copy" data-copy="<%= fiche.telephone %>" title="Copier le numéro"><%- ico('copy', 15) %></button>
        <% } %>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-orange"><%- ico('mail') %></div>
        <div class="contact-body">
          <div class="contact-label">E-mail</div>
          <% if (fiche.email) { %>
            <div class="contact-value"><a href="mailto:<%= fiche.email.split(/[,\/\s]+/)[0] %>"><%= fiche.email %></a></div>
          <% } else { %><div class="contact-value vide">Non renseigné</div><% } %>
        </div>
        <% if (fiche.email) { %>
          <button type="button" class="icon-btn js-copy" data-copy="<%= fiche.email %>" title="Copier l'e-mail"><%- ico('copy', 15) %></button>
        <% } %>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-grey"><%- ico('building') %></div>
        <div class="contact-body">
          <div class="contact-label">Siret</div>
          <% if (fiche.siret) { %><div class="contact-value"><%= fiche.siret %></div>
          <% } else { %><div class="contact-value vide">Non renseigné</div><% } %>
        </div>
        <% if (fiche.siret) { %>
          <button type="button" class="icon-btn js-copy" data-copy="<%= fiche.siret %>" title="Copier le Siret"><%- ico('copy', 15) %></button>
        <% } %>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-teal"><%- ico('briefcase') %></div>
        <div class="contact-body">
          <div class="contact-label">Type de structure</div>
          <% if (fiche.type_structure) { %><div class="contact-value"><%= fiche.type_structure %></div>
          <% } else { %><div class="contact-value vide">Non renseigné</div><% } %>
        </div>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-red"><%- ico('pin') %></div>
        <div class="contact-body">
          <div class="contact-label">Adresse complète</div>
          <% if (fiche.adresse) { %><div class="contact-value"><%= fiche.adresse %></div>
          <% } else { %><div class="contact-value vide">Non renseignée</div><% } %>
        </div>
        <% if (fiche.adresse) { %>
          <a class="icon-btn" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(fiche.adresse) %>" target="_blank" rel="noopener noreferrer" title="Voir sur Google Maps"><%- ico('external', 15) %></a>
        <% } %>
      </div>

      <div class="contact-row">
        <div class="contact-icon ci-indigo"><%- ico('card') %></div>
        <div class="contact-body">
          <div class="contact-label">ID client Stripe</div>
          <% if (fiche.stripe_customer_id) { %><div class="contact-value"><code class="mono"><%= fiche.stripe_customer_id %></code></div>
          <% } else { %><div class="contact-value vide">Pas de client Stripe</div><% } %>
        </div>
        <% if (fiche.stripe_customer_id) { %>
          <button type="button" class="icon-btn js-copy" data-copy="<%= fiche.stripe_customer_id %>" title="Copier l'ID Stripe"><%- ico('copy', 15) %></button>
          <a class="icon-btn" href="<%= fiche.lienStripe %>" target="_blank" rel="noopener noreferrer" title="Ouvrir dans Stripe"><%- ico('external', 15) %></a>
        <% } %>
      </div>
    </div>

    <% if (fiche.note) { %>
      <div class="card">
        <div class="card-title"><span style="display:inline-flex;align-items:center;gap:8px;"><%- ico('note', 17) %>Note</span></div>
        <div class="note-box" style="margin-top:10px;"><%= fiche.note %></div>
      </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-title">
      <span>Abonnements &amp; services <span class="count"><%= groupes.length %></span></span>
      <% if (isAdmin) { %>
        <button type="button" class="btn btn-outline btn-sm" onclick="ouvrirModalAbonnement(null)">
          <span style="margin-right:4px;display:inline-flex;"><%- ico('plus', 13) %></span>Ajouter
        </button>
      <% } %>
    </div>

    <% if (abos.length === 0) { %>
      <div class="empty-state" style="padding:22px 10px;">Aucun abonnement pour ce client pour l'instant.</div>
    <% } %>

    <% groupes.forEach(function (g) { %>
      <% if (g.stripe_subscription_id) { var planif = /^sub_sched_/.test(g.stripe_subscription_id); %>
        <%# Abonnement Stripe : un en-tête commun, puis ses produits / services. %>
        <div class="abo-card abo-groupe">
          <div class="abo-group-head">
            <div class="forfait-icon ci-indigo"><%- ico('card') %></div>
            <div style="flex:1;min-width:0;">
              <div class="abo-title"><%= planif ? 'Planification Stripe' : 'Abonnement Stripe' %>
                <span class="abo-group-n"><%= g.lignes.length %> produit<%= g.lignes.length > 1 ? 's' : '' %> / service<%= g.lignes.length > 1 ? 's' : '' %></span></div>
              <div class="abo-group-meta">
                <code class="mono" title="<%= g.stripe_subscription_id %>"><%= g.stripe_subscription_id %></code>
                <button type="button" class="icon-btn sm js-copy" data-copy="<%= g.stripe_subscription_id %>" title="Copier l'ID"><%- ico('copy', 12) %></button>
                <% g.periodicites.forEach(function (pr) { %><span class="meta-chip" title="Périodicité"><%- ico('repeat', 12) %><%= K.PERIODICITE_LABEL[pr] %></span><% }); %>
                <% g.moyens.forEach(function (m) { %><span class="meta-chip" title="Moyen de paiement"><%- ico('card', 12) %><%= m %></span><% }); %>
              </div>
            </div>
            <% if (isAdmin) { %>
              <div class="abo-price">
                <% if (g.montantAnnuel !== null) { %><%= fmt(g.montantAnnuel) %><span class="abo-price-unit"><%= g.ponctuel ? ' ponctuel' : '/an' %></span>
                <% } else { %><span class="muted" style="font-weight:600;">Sans prix</span><% } %>
                <% if (g.lignes.length > 1) { %><small>total de l'abonnement</small><% } %>
              </div>
            <% } %>
          </div>
          <div class="abo-lines">
            <% g.lignes.forEach(function (a) { %>
              <%- include('partials/abo-ligne', { a: a, fiche: fiche, isAdmin: isAdmin, K: K, ico: ico, CATEGORIE_ICO: CATEGORIE_ICO, attr: attr, fmt: fmt, dansGroupe: true }) %>
            <% }); %>
          </div>
          <div class="abo-actions abo-group-actions">
            <a href="<%= g.lienStripe %>" target="_blank" rel="noopener noreferrer" class="btn btn-stripe btn-xs" title="<%= g.stripe_subscription_id %>">
              <span style="margin-right:4px;display:inline-flex;"><%- ico('card', 12) %></span>Ouvrir dans Stripe
            </a>
            <span class="spacer"></span>
            <% if (isAdmin) { %>
              <button type="button" class="btn btn-outline btn-xs" onclick="ouvrirModalAbonnement(this)"
                data-stripe="<%= g.stripe_subscription_id %>" data-periodicite="<%= g.periodicites[0] || '' %>" data-moyen="<%= g.moyens[0] || '' %>"
                data-domaine="<%= attr(g.lignes[0].domaine) %>" data-type-site="<%= attr(g.lignes[0].type_site) %>" data-hostinger="<%= attr(g.lignes[0].hostinger) %>"
                title="Ajouter un produit / service à cet abonnement Stripe">
                <span style="margin-right:4px;display:inline-flex;"><%- ico('plus', 12) %></span>Produit / service
              </button>
            <% } %>
          </div>
        </div>
      <% } else { %>
        <div class="abo-card">
          <%- include('partials/abo-ligne', { a: g.lignes[0], fiche: fiche, isAdmin: isAdmin, K: K, ico: ico, CATEGORIE_ICO: CATEGORIE_ICO, attr: attr, fmt: fmt, dansGroupe: false }) %>
        </div>
      <% } %>
    <% }); %>
  </div>
</div>

<% if (isAdmin) { %>
<div id="modal-client" class="modal-overlay" style="display:none;">
  <div class="modal-box wide">
    <div class="modal-box-header">
      <h3 style="margin:0;">Modifier le client</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-client').style.display='none'">&times;</button>
    </div>
    <form method="POST" action="/clients/<%= fiche.id %>">
      <label>Société</label>
      <input name="societe" value="<%= fiche.societe || '' %>">
      <div class="form-grid-2">
        <div>
          <label>Client (contact)</label>
          <input name="client" value="<%= fiche.client || '' %>">
        </div>
        <div>
          <label>Type de structure</label>
          <%- include('partials/select-field', {
            name: 'type_structure', id: 'client-structure', value: fiche.type_structure || '', placeholder: 'Non renseigné',
            options: [{ value: '', label: 'Non renseigné' }].concat((K.TYPES_STRUCTURE.indexOf(fiche.type_structure) === -1 && fiche.type_structure ? [fiche.type_structure] : []).concat(K.TYPES_STRUCTURE).map(function (v) { return { value: v, label: v }; }))
          }) %>
        </div>
      </div>
      <div class="form-grid-2">
        <div>
          <label>Téléphone</label>
          <input name="telephone" value="<%= fiche.telephone || '' %>">
        </div>
        <div>
          <label>E-mail</label>
          <input name="email" value="<%= fiche.email || '' %>">
        </div>
      </div>
      <label>Siret</label>
      <input name="siret" value="<%= fiche.siret || '' %>">
      <label>Adresse complète</label>
      <input name="adresse" value="<%= fiche.adresse || '' %>">
      <label>ID client Stripe</label>
      <input name="stripe_customer_id" value="<%= fiche.stripe_customer_id || '' %>" placeholder="cus_… (ou lien du dashboard Stripe)">
      <label>Note</label>
      <textarea name="note" rows="4"><%= fiche.note || '' %></textarea>
      <button class="btn btn-primary" type="submit" style="width:100%;margin-top:6px;">Enregistrer</button>
    </form>
    <form method="POST" action="/clients/<%= fiche.id %>/supprimer" style="margin:12px 0 0;padding-top:12px;border-top:1px solid #F1F4F8;"
      onsubmit="return confirm('Supprimer définitivement ce client et tous ses abonnements ?');">
      <button type="submit" class="btn btn-danger" style="width:100%;">
        <span style="margin-right:6px;display:inline-flex;"><%- ico('trash', 15) %></span>Supprimer ce client
      </button>
    </form>
  </div>
</div>

<div id="modal-abo" class="modal-overlay" style="display:none;">
  <div class="modal-box wide">
    <div class="modal-box-header">
      <h3 style="margin:0;" id="modal-abo-titre">Ajouter un abonnement</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-abo').style.display='none'">&times;</button>
    </div>
    <form method="POST" action="/clients/<%= fiche.id %>/abonnements" id="form-abo">
      <label>Produit / service</label>
      <input name="produit" id="abo-produit" placeholder="ex. Hébergement & Nom de Domaine - 1an">
      <label>Description (libellé Stripe)</label>
      <input name="description" id="abo-description" placeholder="ex. Hébergement & Domaine : monsite.fr">
      <div class="form-grid-2">
        <div>
          <label>Catégorie</label>
          <%- include('partials/select-field', {
            name: 'categorie', id: 'abo-categorie', value: 'hebergement_domaine',
            options: K.CATEGORIES.map(function (v) { return { value: v, label: K.CATEGORIE_LABEL[v] }; })
          }) %>
        </div>
        <div>
          <label>Domaine(s)</label>
          <input name="domaine" id="abo-domaine" placeholder="monsite.fr, autre.fr">
        </div>
      </div>
      <div class="form-grid-2">
        <div>
          <label>Type de site</label>
          <%- include('partials/select-field', {
            name: 'type_site', id: 'abo-type-site', value: '', placeholder: 'Non renseigné',
            options: [{ value: '', label: 'Non renseigné' }].concat(K.TYPES_SITE.map(function (v) { return { value: v, label: v }; }))
          }) %>
        </div>
        <div>
          <label>Chez Hostinger</label>
          <%- include('partials/select-field', {
            name: 'hostinger', id: 'abo-hostinger', value: '', placeholder: 'Non renseigné',
            options: [{ value: '', label: 'Non renseigné' }].concat(K.HOSTINGER.map(function (v) { return { value: v, label: v }; }))
          }) %>
        </div>
      </div>
      <div class="form-grid-3">
        <div>
          <label>Prix unitaire (€, par échéance)</label>
          <input name="prix_unitaire" id="abo-prix" inputmode="decimal" placeholder="150">
        </div>
        <div>
          <label>Quantité</label>
          <input name="quantite" id="abo-quantite" inputmode="numeric" placeholder="1">
        </div>
        <div>
          <label>Périodicité</label>
          <%- include('partials/select-field', {
            name: 'periodicite', id: 'abo-periodicite', value: 'annuel', placeholder: 'Ponctuel',
            options: [{ value: '', label: 'Ponctuel' }].concat(K.PERIODICITES.map(function (v) { return { value: v, label: K.PERIODICITE_LABEL[v] }; }))
          }) %>
        </div>
      </div>
      <div class="form-grid-2">
        <div>
          <label>Moyen de paiement</label>
          <%- include('partials/select-field', {
            name: 'moyen_paiement', id: 'abo-moyen', value: 'Prélèvement',
            options: K.MOYENS_PAIEMENT.map(function (v) { return { value: v, label: v }; })
          }) %>
        </div>
        <div>
          <label>ID abonnement Stripe</label>
          <input name="stripe_subscription_id" id="abo-stripe" placeholder="sub_… (ou lien Stripe)">
        </div>
      </div>
      <label>Lien de connexion au site</label>
      <input name="lien_connexion" id="abo-lien" placeholder="monsite.fr/pixel-digital">
      <div class="form-grid-2">
        <div>
          <label>Identifiant</label>
          <input name="identifiant" id="abo-identifiant" autocomplete="off">
        </div>
        <div>
          <label>Mot de passe</label>
          <input name="mot_de_passe" id="abo-mdp" autocomplete="off">
        </div>
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%;margin-top:6px;" id="modal-abo-submit">Ajouter</button>
    </form>
  </div>
</div>

<script>
  function setSelect(id, value, placeholderLabel) {
    var hidden = document.getElementById(id);
    var field = hidden.closest('.select-field');
    var opt = field.querySelector('.select-option[data-value="' + String(value == null ? '' : value).replace(/"/g, '\\"') + '"]');
    field.querySelectorAll('.select-option').forEach(function (o) { o.classList.remove('selected'); });
    if (!opt) {
      hidden.value = value || '';
      field.querySelector('.select-label').textContent = value || placeholderLabel || '';
      return;
    }
    hidden.value = opt.dataset.value;
    field.querySelector('.select-label').textContent = opt.dataset.label;
    opt.classList.add('selected');
  }

  window.ouvrirModalModifierClient = function () {
    document.getElementById('modal-client').style.display = 'flex';
  };

  // el = bouton « modifier » (data-*) ou null pour un nouvel abonnement.
  // el = bouton « modifier » (data-id + data-*), bouton « + produit / service » d'un
  // abonnement Stripe (data-stripe sans data-id : nouveau produit pré-rempli), ou null.
  window.ouvrirModalAbonnement = function (el) {
    var d = el ? el.dataset : {};
    var modif = !!(el && d.id);
    var modal = document.getElementById('modal-abo');
    var form = document.getElementById('form-abo');
    form.reset();
    document.getElementById('modal-abo-titre').textContent = modif ? 'Modifier le produit / service' : (d.stripe ? 'Ajouter un produit / service à l\'abonnement' : 'Ajouter un abonnement');
    document.getElementById('modal-abo-submit').textContent = modif ? 'Enregistrer' : 'Ajouter';
    form.action = '/clients/<%= fiche.id %>/abonnements' + (modif ? '/' + d.id : '');
    document.getElementById('abo-produit').value = d.produit || '';
    document.getElementById('abo-description').value = d.description || '';
    document.getElementById('abo-domaine').value = d.domaine || '';
    document.getElementById('abo-prix').value = d.prix || '';
    document.getElementById('abo-quantite').value = d.quantite || '';
    document.getElementById('abo-stripe').value = d.stripe || '';
    document.getElementById('abo-lien').value = d.lien || '';
    document.getElementById('abo-identifiant').value = d.identifiant || '';
    document.getElementById('abo-mdp').value = d.mdp || '';
    setSelect('abo-categorie', modif ? d.categorie : 'hebergement_domaine');
    setSelect('abo-type-site', el ? (d.typeSite || '') : 'WordPress', 'Non renseigné');
    setSelect('abo-hostinger', el ? (d.hostinger || '') : '', 'Non renseigné');
    setSelect('abo-periodicite', el ? (d.periodicite || '') : 'annuel', 'Ponctuel');
    setSelect('abo-moyen', el ? (d.moyen || '') : 'Prélèvement');
    modal.style.display = 'flex';
  };
</script>
<% } %>

<script>
  // Boutons « copier » : coche verte 1,5 s en retour.
  document.querySelectorAll('.js-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(btn.dataset.copy || '').then(function () {
        var avant = btn.innerHTML;
        btn.classList.add('ok');
        btn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
        setTimeout(function () { btn.classList.remove('ok'); btn.innerHTML = avant; }, 1500);
      });
    });
  });

  // Mots de passe masqués par défaut ; l'œil les révèle le temps d'un clic.
  document.querySelectorAll('.js-pwd-toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var code = btn.parentNode.querySelector('.js-pwd-value');
      var visible = code.dataset.visible === '1';
      code.textContent = visible ? '••••••••••' : code.dataset.pwd;
      code.dataset.visible = visible ? '0' : '1';
      btn.classList.toggle('ok', !visible);
    });
  });
</script>

