<%- include('partials/header', { title: fiche.societe || fiche.client || 'Fiche client', active: 'clients' }) %>

<a href="/clients" class="btn btn-outline" style="margin-bottom:16px;">&larr; Retour aux clients</a>

<% var boutonMainWP = fiche.lienMainWP && fiche.mainwpConnecte !== false; %>
<% var lienSite = boutonMainWP ? fiche.site_web : (fiche.lien_connexion || fiche.site_web); %>

<div class="card">
  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:18px;">
    <div>
      <h3 style="margin:0;"><%= fiche.societe || fiche.client || 'Client sans nom' %></h3>
      <% if (fiche.societe && fiche.client) { %><div style="font-size:13px;color:#9AA7B5;margin-top:3px;"><%= fiche.client %></div><% } %>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <% if (fiche.lienMainWP && fiche.mainwpConnecte !== false) { %>
        <a href="<%= fiche.lienMainWP %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary"
          title="Ouvre le wp-admin du site via MainWP (session MainWP requise)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          Connexion en 1 clic
        </a>
      <% } %>
      <% if (lienSite) { %>
        <a href="<%= lienSite %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:5px;"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          <%= boutonMainWP ? 'Ouvrir le site' : 'Se connecter au site' %>
        </a>
      <% } %>
      <% if (fiche.lienMainWP && fiche.mainwpConnecte === false) { %>
        <span class="muted" style="font-size:12.5px;align-self:center;" title="Ce domaine n'est pas géré par le tableau de bord MainWP (site non WordPress ou plugin MainWP Child absent).">Pas connecté à MainWP</span>
      <% } %>
      <% if (isAdmin) { %>
        <button type="button" class="btn btn-outline" onclick="ouvrirModalModifierClient()">Modifier</button>
      <% } %>
    </div>
  </div>

  <div class="fiche-grid">
    <div><span class="fiche-label">Site web</span>
      <% if (fiche.site_web) { %><a href="<%= fiche.site_web %>" target="_blank" rel="noopener noreferrer"><%= fiche.site_web %></a><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div><span class="fiche-label">Société</span>
      <% if (fiche.societe) { %><%= fiche.societe %><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div><span class="fiche-label">Client</span>
      <% if (fiche.client) { %><%= fiche.client %><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div><span class="fiche-label">Téléphone</span>
      <% if (fiche.telephone) { %><a href="tel:<%= fiche.telephone.replace(/\s/g,'') %>"><%= fiche.telephone %></a><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div><span class="fiche-label">E-mail</span>
      <% if (fiche.email) { %><a href="mailto:<%= fiche.email %>"><%= fiche.email %></a><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div><span class="fiche-label">Siret</span>
      <% if (fiche.siret) { %><%= fiche.siret %><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
    <div style="grid-column:1/-1;"><span class="fiche-label">Adresse</span>
      <% if (fiche.adresse) { %><%= fiche.adresse %><% } else { %><span class="muted">&mdash;</span><% } %>
    </div>
  </div>

  <% if (fiche.note) { %>
    <div style="margin-top:16px;">
      <span class="fiche-label">Note</span>
      <div style="white-space:pre-wrap;font-size:13.5px;line-height:1.55;"><%= fiche.note %></div>
    </div>
  <% } %>
</div>

<div class="card">
  <h3 style="margin:0 0 14px;">Forfaits &amp; services (<%= fiche.forfaits.length %>)</h3>

  <% if (fiche.forfaits.length === 0) { %>
    <div class="empty-state" style="padding:18px;">Aucun forfait pour ce client pour l'instant.</div>
  <% } %>

  <% fiche.forfaits.forEach(function(f) { %>
    <div class="list-row" style="align-items:center;gap:12px;">
      <span class="badge forfait-<%= f.type %>"><%= FORFAIT_LABEL[f.type] %></span>
      <div style="flex:1;font-size:13.5px;"><%= f.libelle || '' %></div>
      <% if (isAdmin) { %>
        <form method="POST" action="/clients/<%= fiche.id %>/forfaits/<%= f.id %>/supprimer" style="margin:0;"
          onsubmit="return confirm('Retirer ce forfait ?');">
          <button type="submit" class="btn btn-outline" style="padding:6px 12px;">Retirer</button>
        </form>
      <% } %>
    </div>
  <% }); %>

  <% if (isAdmin) { %>
    <form method="POST" action="/clients/<%= fiche.id %>/forfaits"
      style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin:16px 0 0;padding-top:16px;border-top:1px solid #F1F4F8;">
      <div style="width:200px;">
        <label style="margin-top:0;">Forfait</label>
        <% var fopts = FORFAITS.map(function (v) { return { value: v, label: FORFAIT_LABEL[v] }; }); %>
        <div class="select-field">
          <button type="button" class="select-display">
            <span class="select-label"><%= FORFAIT_LABEL['hebergement'] %></span>
            <svg class="select-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <input type="hidden" name="type" id="forfait-type" class="select-value" value="hebergement">
          <div class="select-popup">
            <% fopts.forEach(function (o) { %>
              <div class="select-option <%= o.value === 'hebergement' ? 'selected' : '' %>" data-value="<%= o.value %>" data-label="<%= o.label %>"><%= o.label %></div>
            <% }); %>
          </div>
        </div>
      </div>
      <div style="flex:1;min-width:180px;">
        <label style="margin-top:0;">Libellé (optionnel)</label>
        <input name="libelle" placeholder="ex. monsite.fr" style="margin-bottom:0;">
      </div>
      <button type="submit" class="btn btn-primary">Ajouter</button>
    </form>
  <% } %>
</div>

<% if (isAdmin) { %>
<div style="margin-top:4px;">
  <form method="POST" action="/clients/<%= fiche.id %>/supprimer"
    onsubmit="return confirm('Supprimer définitivement ce client et tous ses forfaits ?');">
    <button type="submit" class="btn" style="background:#C2502E;color:#fff;">Supprimer ce client</button>
  </form>
</div>

<div id="modal-client" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-box-header">
      <h3 style="margin:0;">Modifier le client</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-client').style.display='none'">&times;</button>
    </div>
    <form method="POST" action="/clients/<%= fiche.id %>">
      <label>Société</label>
      <input name="societe" value="<%= fiche.societe || '' %>">
      <label>Client (contact)</label>
      <input name="client" value="<%= fiche.client || '' %>">
      <label>Site web</label>
      <input name="site_web" value="<%= fiche.site_web || '' %>" placeholder="https://...">
      <label>Téléphone</label>
      <input name="telephone" value="<%= fiche.telephone || '' %>">
      <label>E-mail</label>
      <input type="email" name="email" value="<%= fiche.email || '' %>">
      <label>Siret</label>
      <input name="siret" value="<%= fiche.siret || '' %>">
      <label>Adresse</label>
      <input name="adresse" value="<%= fiche.adresse || '' %>">
      <label>Lien de connexion au site (admin)</label>
      <input name="lien_connexion" value="<%= fiche.lien_connexion || '' %>" placeholder="https://.../wp-admin">
      <label>Note</label>
      <textarea name="note" rows="3"><%= fiche.note || '' %></textarea>
      <button class="btn btn-primary" type="submit" style="width:100%;margin-top:6px;">Enregistrer</button>
    </form>
  </div>
</div>

<script>
  window.ouvrirModalModifierClient = function () {
    document.getElementById('modal-client').style.display = 'flex';
  };
</script>
<% } %>

<%- include('partials/footer') %>
