<%- include('partials/header', { title: 'Tableau de bord', active: 'dashboard' }) %>

<div class="grid-4">
  <a href="/alternants" class="card" style="display:block;">
    <div class="stat-label">Alternants</div>
    <div class="stat-value" style="color:#2E5C8A;"><%= alternants.length %></div>
  </a>
  <a href="/conges" class="card" style="display:block;">
    <div class="stat-label">Congés en attente</div>
    <div class="stat-value" style="color:#B7791F;"><%= pending.length %></div>
  </a>
  <a href="/tickets" class="card" style="display:block;">
    <div class="stat-label">Tickets ouverts</div>
    <div class="stat-value" style="color:#C2502E;"><%= ticketsOuverts.length %></div>
  </a>
  <a href="/projets" class="card" style="display:block;">
    <div class="stat-label">Projets actifs</div>
    <div class="stat-value" style="color:#1F9D6B;"><%= projets.length %></div>
  </a>
</div>

<div class="grid-14">
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <h3 style="margin:0;">Tickets ouverts</h3>
      <a href="/tickets" class="btn btn-outline">Voir tout</a>
    </div>
    <% if (ticketsOuverts.length === 0) { %>
      <p style="color:#9AA7B5;">Aucun ticket ouvert. 🎉</p>
    <% } else { %>
      <% ticketsOuverts.slice(0, 6).forEach(function(t) { %>
        <div class="list-row" style="gap:12px;">
          <span class="badge <%= PRIORITE_BADGE[t.priorite] %>"><%= PRIORITE_LABEL[t.priorite] %></span>
          <div style="flex:1;font-size:13px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= t.titre %></div>
          <div class="avatar-stack">
            <% t.assignes.forEach(function(m) { %>
              <div class="avatar" style="width:24px;height:24px;font-size:9.5px;background:<%= m.avatar_color %>;" title="<%= m.prenom %> <%= m.nom %>"><%= (m.prenom[0]+m.nom[0]).toUpperCase() %></div>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <h3>Congés en attente</h3>
    <% if (pending.length === 0) { %>
      <p style="color:#9AA7B5;">Aucune demande en attente.</p>
    <% } else { %>
      <div class="table-scroll">
      <table>
        <tr><th>Alternant</th><th>Dates</th><th>Jours</th><th></th></tr>
        <% pending.forEach(function(c) { %>
          <tr>
            <td><%= c.profiles.prenom %> <%= c.profiles.nom %></td>
            <td><%= formatDate(c.date_debut) %> → <%= formatDate(c.date_fin) %></td>
            <td><%= c.jours %></td>
            <td><a href="/conges" class="btn btn-outline">Traiter</a></td>
          </tr>
        <% }); %>
      </table>
      </div>
    <% } %>
  </div>
</div>

<div class="card">
  <h3 style="margin:0 0 14px;">Soldes par alternant</h3>
  <% if (soldes.length === 0) { %>
    <div class="empty-state">Aucun alternant.</div>
  <% } else { %>
    <div class="table-scroll">
    <table>
      <tr><th>Alternant</th><th>Congés disponibles</th><th>Heures supp.</th></tr>
      <% soldes.forEach(function(s) { %>
        <tr>
          <td>
            <div class="row-flex" style="gap:8px;">
              <span class="avatar" style="width:26px;height:26px;font-size:10px;border-radius:7px;background:<%= s.alternant.avatar_color %>;"><%= (s.alternant.prenom[0]+s.alternant.nom[0]).toUpperCase() %></span>
              <%= s.alternant.prenom %> <%= s.alternant.nom %>
            </div>
          </td>
          <td style="font-weight:700;color:<%= s.congesDispo < 0 ? '#C2502E' : '#15784F' %>;"><%= s.congesDispo %> j</td>
          <td style="font-weight:700;color:<%= s.heures < 0 ? '#C2502E' : '#5B6B7D' %>;"><%= s.heures %> h</td>
        </tr>
      <% }); %>
    </table>
    </div>
  <% } %>
</div>

<div class="grid-14">
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <h3 style="margin:0;">Projets actifs</h3>
      <a href="/projets" class="btn btn-outline">Voir tout</a>
    </div>
    <% if (projets.length === 0) { %>
      <p style="color:#9AA7B5;">Aucun projet actif.</p>
    <% } else { %>
      <% projets.slice(0, 6).forEach(function(p) { %>
        <div style="padding:10px 2px;border-bottom:1px solid #F1F4F8;">
          <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:5px;">
            <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.nom %></span>
            <span style="color:#5B6B7D;"><%= p.nbTerminees %>/<%= p.nbTaches %> · <%= p.pct %>%</span>
          </div>
          <div class="progress-bar"><div style="width:<%= p.pct %>%;"></div></div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <h3>Prochaines semaines d'école</h3>
    <% if (ecole.length === 0) { %>
      <p style="color:#9AA7B5;">Aucune semaine d'école à venir.</p>
    <% } else { %>
      <% ecole.forEach(function(s) { %>
        <div class="list-row" style="gap:10px;">
          <span class="avatar" style="width:26px;height:26px;font-size:10px;border-radius:7px;background:<%= s.alternant.avatar_color %>;"><%= (s.alternant.prenom[0]+s.alternant.nom[0]).toUpperCase() %></span>
          <div style="flex:1;font-size:13px;font-weight:600;"><%= s.alternant.prenom %> <%= s.alternant.nom %></div>
          <div style="font-size:12.5px;color:#5B6B7D;">semaine du <%= formatDate(s.lundi) %></div>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:14px;">
    <h3 style="margin:0;">Planning de la semaine</h3>
    <div class="legend">
      <div class="legend-item"><span class="type-dot dot-entreprise"></span>Entreprise</div>
      <div class="legend-item"><span class="type-dot dot-ecole"></span>École</div>
      <div class="legend-item"><span class="type-dot dot-conge"></span>Congé / Récup.</div>
      <div class="legend-item"><span class="type-dot dot-absent"></span>Absent</div>
      <div class="legend-item"><span class="type-dot dot-ferie"></span>Férié</div>
    </div>
  </div>
  <% if (alternants.length === 0) { %>
    <div class="empty-state">Aucun alternant.</div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <div style="display:flex;margin-bottom:8px;padding-left:200px;gap:6px;min-width:600px;">
      <% jours.forEach(function(j) { %>
        <div style="flex:1;text-align:center;">
          <div style="font-size:11px;color:#9AA7B5;font-weight:600;text-transform:uppercase;"><%= j.dow %></div>
          <div style="font-size:14px;font-weight:700;color:#5B6B7D;"><%= j.num %></div>
        </div>
      <% }); %>
    </div>
    <% alternants.forEach(function(a) { %>
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;min-width:600px;">
        <div style="width:200px;flex-shrink:0;" class="row-flex">
          <div class="avatar" style="background:<%= a.avatar_color %>;"><%= (a.prenom[0]+a.nom[0]).toUpperCase() %></div>
          <div style="min-width:0;overflow:hidden;">
            <div style="font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= a.prenom %> <%= a.nom %></div>
            <div style="font-size:11.5px;color:#9AA7B5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= a.poste || '—' %></div>
          </div>
        </div>
        <% jours.forEach(function(j) { %>
          <% const t = planningMap[a.id + j.iso]; %>
          <div class="<%= t ? 'type-'+t : '' %>" style="flex:1;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;<%= !t ? 'background:#F6F8FB;' : '' %>">
            <% if (t) { %><span class="type-dot dot-<%= t %>" style="margin:0;"></span><% } %>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
