<%- include('partials/header', { title: 'Clients', active: 'clients' }) %>

<%
  // Compteurs par catégorie pour les filtres.
  var parCategorie = {};
  clients.forEach(function (c) { c.categories.forEach(function (k) { parCategorie[k] = (parCategorie[k] || 0) + 1; }); });
  var fmt = K.formatEuro;
%>

<%# Les montants sont réservés à l'admin : les alternants ne voient que les compteurs. %>
<div class="<%= isAdmin ? 'grid-4' : 'grid-2' %>">
  <div class="card">
    <div class="stat-label">Clients</div>
    <div class="stat-value" style="color:#2E5C8A;"><%= global.clients %></div>
  </div>
  <div class="card">
    <div class="stat-label">Abonnements &amp; services</div>
    <div class="stat-value" style="color:#7A53C1;"><%= global.abonnements %></div>
  </div>
  <% if (isAdmin) { %>
    <div class="card">
      <div class="stat-label">Récurrent mensuel</div>
      <div class="stat-value" style="color:#1F9D6B;"><%= fmt(global.mensuel) %><span class="stat-unit">/mois</span></div>
      <div class="stat-sub"><%= fmt(global.annuel) %> d'abonnements annuels en plus</div>
    </div>
    <div class="card">
      <div class="stat-label">CA annuel estimé</div>
      <div class="stat-value" style="color:#B7791F;"><%= fmt(global.caAnnuel) %></div>
      <div class="stat-sub">mensuel × 12 + annuel, hors offerts</div>
    </div>
  <% } %>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
    <h3 style="margin:0;">Clients (<span id="client-count"><%= clients.length %></span>)</h3>
    <div class="inline-filter-bar">
      <input type="search" id="client-search" class="search-input" placeholder="Rechercher (n°, société, contact, domaine, mail, Siret, Stripe…)" autocomplete="off" style="width:340px;">
      <% if (isAdmin) { %>
        <button type="button" class="btn btn-primary" onclick="ouvrirModalClient()">+ Nouveau client</button>
      <% } %>
    </div>
  </div>

  <div class="filter-chips" id="client-filtres">
    <button type="button" class="chip-filter active" data-filtre="">Tous<span class="n"><%= clients.length %></span></button>
    <% K.CATEGORIES.forEach(function (k) { if (!parCategorie[k]) return; %>
      <button type="button" class="chip-filter" data-filtre="cat:<%= k %>"><%= K.CATEGORIE_LABEL[k] %><span class="n"><%= parCategorie[k] %></span></button>
    <% }); %>
    <button type="button" class="chip-filter" data-filtre="stripe:1">Stripe<span class="n"><%= global.stripe %></span></button>
    <button type="button" class="chip-filter" data-filtre="stripe:0">Hors Stripe<span class="n"><%= global.clients - global.stripe %></span></button>
  </div>

  <% if (clients.length === 0) { %>
    <div class="empty-state">Aucun client pour l'instant.</div>
  <% } %>

  <div class="client-table-head">
    <div class="cr-num">N°</div>
    <div class="cr-main">Client</div>
    <div class="cr-sites">Sites</div>
    <div class="cr-cats">Abonnements</div>
    <% if (isAdmin) { %><div class="cr-montant">Facturation</div><% } %>
    <div class="cr-stripe">Stripe</div>
    <div class="cr-actions"></div>
  </div>

  <% clients.forEach(function(c) { %>
    <%
      var titre = c.societe || c.client || 'Client sans nom';
      var sousTitre = (c.societe && c.client && c.client !== c.societe) ? c.client : '';
      var recherche = [c.numero, c.societe, c.client, c.email, c.telephone, c.siret, c.adresse, c.type_structure, c.stripe_customer_id, c.note]
        .concat(c.sites)
        .concat(c.abonnements.map(function (a) { return [a.produit, a.description, K.CATEGORIE_LABEL[a.categorie], a.stripe_subscription_id, a.moyen_paiement, a.type_site, a.identifiant].filter(Boolean).join(' '); }))
        .filter(Boolean).join(' ').toLowerCase();
    %>
    <div class="list-row client-row" data-search="<%= recherche %>" data-cats="<%= c.categories.join(',') %>" data-stripe="<%= c.stripe_customer_id ? 1 : 0 %>"
      style="cursor:pointer;" onclick="window.location='/clients/<%= c.id %>'">
      <div class="cr-num"><% if (c.numero) { %><span class="num-pill"><%= c.numero %></span><% } else { %><span class="muted">—</span><% } %></div>
      <div class="cr-main">
        <div style="font-size:13.5px;font-weight:700;"><%= titre %></div>
        <% if (sousTitre) { %><div style="font-size:12.5px;color:#9AA7B5;margin-top:2px;"><%= sousTitre %></div><% } %>
      </div>
      <div class="cr-sites">
        <% if (c.sites.length) { %>
          <span class="cr-site"><%= c.sites[0] %></span><% if (c.sites.length > 1) { %><span class="cr-more" title="<%= c.sites.slice(1).join(', ') %>">+<%= c.sites.length - 1 %></span><% } %>
        <% } else { %><span class="muted">—</span><% } %>
      </div>
      <div class="cr-cats">
        <% if (c.abonnements.length === 0) { %>
          <span class="muted" style="font-size:12.5px;">Aucun abonnement</span>
        <% } else { %>
          <div style="display:flex;flex-wrap:wrap;gap:5px;">
            <% c.categories.forEach(function (k) { var n = c.abonnements.filter(function (a) { return a.categorie === k; }).length; %>
              <span class="badge cat-<%= k %>"><%= K.CATEGORIE_LABEL[k] %><% if (n > 1) { %> ×<%= n %><% } %></span>
            <% }); %>
          </div>
        <% } %>
      </div>
      <% if (isAdmin) { %>
        <div class="cr-montant">
          <% if (c.totaux.nbMensuel) { %><div><%= fmt(c.totaux.mensuel) %><span class="muted">/mois</span></div><% } %>
          <% if (c.totaux.nbAnnuel) { %><div><%= fmt(c.totaux.annuel) %><span class="muted">/an</span></div><% } %>
          <% if (!c.totaux.nbMensuel && !c.totaux.nbAnnuel) { %><span class="muted">—</span><% } %>
        </div>
      <% } %>
      <div class="cr-stripe">
        <% if (c.stripe_customer_id) { %><span class="stripe-pill on" title="<%= c.stripe_customer_id %>"><%- ico('card', 12) %>Stripe</span>
        <% } else { %><span class="stripe-pill off">Hors Stripe</span><% } %>
      </div>
      <div class="cr-actions">
        <% if (c.lienMainWP) { %>
          <a href="<%= c.lienMainWP %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm"
            onclick="event.stopPropagation()" title="Connexion en 1 clic au wp-admin via MainWP">
            <span style="margin-right:4px;display:inline-flex;"><%- ico('zap', 13) %></span>Connexion
          </a>
        <% } %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9AA7B5" stroke-width="2" style="flex-shrink:0;"><path d="M9 6l6 6-6 6"></path></svg>
      </div>
    </div>
  <% }); %>
  <div class="empty-state" id="client-vide" style="display:none;">Aucun client ne correspond à la recherche.</div>
</div>

<% if (isAdmin) { %>
<div id="modal-client" class="modal-overlay" style="display:none;">
  <div class="modal-box wide">
    <div class="modal-box-header">
      <h3 style="margin:0;">Nouveau client</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-client').style.display='none'">✕</button>
    </div>
    <form method="POST" action="/clients">
      <div class="form-grid-2">
        <div>
          <label>Numéro client</label>
          <input name="numero" placeholder="ex. 167" inputmode="numeric">
        </div>
        <div>
          <label>Type de structure</label>
          <%- include('partials/select-field', {
            name: 'type_structure', id: 'client-structure', value: '', placeholder: 'Non renseigné',
            options: [{ value: '', label: 'Non renseigné' }].concat(K.TYPES_STRUCTURE.map(function (v) { return { value: v, label: v }; }))
          }) %>
        </div>
      </div>
      <label>Société</label>
      <input name="societe" placeholder="ex. Boulangerie Martin">
      <label>Client (contact)</label>
      <input name="client" placeholder="ex. Marie Martin">
      <div class="form-grid-2">
        <div>
          <label>Téléphone</label>
          <input name="telephone" placeholder="06 12 34 56 78">
        </div>
        <div>
          <label>E-mail</label>
          <input name="email" placeholder="contact@exemple.fr">
        </div>
      </div>
      <label>Siret</label>
      <input name="siret" placeholder="123 456 789 00012">
      <label>Adresse complète</label>
      <input name="adresse" placeholder="12 rue…, 75000 Paris, FR">
      <label>ID client Stripe</label>
      <input name="stripe_customer_id" placeholder="cus_… (ou lien du dashboard Stripe)">
      <label>Note</label>
      <textarea name="note" rows="3" placeholder="Informations complémentaires…"></textarea>
      <p class="muted" style="font-size:12px;margin:2px 0 12px;">Les abonnements et services s'ajoutent ensuite depuis la fiche du client.</p>
      <button class="btn btn-primary" type="submit" style="width:100%;">Créer le client</button>
    </form>
  </div>
</div>
<% } %>

<script>
  // Recherche live + filtres (catégorie, Stripe) sur les lignes déjà rendues.
  (function () {
    var input = document.getElementById('client-search');
    var rows = Array.prototype.slice.call(document.querySelectorAll('.client-row'));
    var compteur = document.getElementById('client-count');
    var vide = document.getElementById('client-vide');
    var chips = Array.prototype.slice.call(document.querySelectorAll('#client-filtres .chip-filter'));
    var filtre = '';

    function appliquer() {
      var q = (input ? input.value : '').trim().toLowerCase();
      var n = 0;
      rows.forEach(function (r) {
        var ok = (r.dataset.search || '').indexOf(q) !== -1;
        if (ok && filtre) {
          var p = filtre.split(':');
          if (p[0] === 'cat') ok = (r.dataset.cats || '').split(',').indexOf(p[1]) !== -1;
          else if (p[0] === 'stripe') ok = r.dataset.stripe === p[1];
        }
        r.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      if (compteur) compteur.textContent = n;
      if (vide) vide.style.display = (n === 0 && rows.length) ? '' : 'none';
    }

    if (input) input.addEventListener('input', appliquer);
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        filtre = chip.dataset.filtre || '';
        chips.forEach(function (c) { c.classList.toggle('active', c === chip); });
        appliquer();
      });
    });
  })();

  window.ouvrirModalClient = function () {
    var modal = document.getElementById('modal-client');
    modal.querySelector('form').reset();
    modal.style.display = 'flex';
  };
</script>

<%- include('partials/footer') %>
