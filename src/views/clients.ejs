<%- include('partials/header', { title: 'Clients', active: 'clients' }) %>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px;">
    <h3 style="margin:0;">Clients (<span id="client-count"><%= clients.length %></span>)</h3>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
      <input type="search" id="client-search" placeholder="Rechercher (société, client, mail, siret…)" autocomplete="off"
        style="flex:0 0 auto;width:280px;max-width:100%;height:40px;padding:0 14px;border:1px solid #DCE2EA;border-radius:10px;font-size:13.5px;">
      <% if (isAdmin) { %>
        <button type="button" class="btn btn-primary" onclick="ouvrirModalClient()">+ Nouveau client</button>
      <% } %>
    </div>
  </div>

  <% if (clients.length === 0) { %>
    <div class="empty-state">Aucun client pour l'instant.</div>
  <% } %>

  <% clients.forEach(function(c) { %>
    <%
      var titre = c.societe || c.client || 'Client sans nom';
      var sousTitre = (c.societe && c.client) ? c.client : '';
      var recherche = [c.societe, c.client, c.email, c.telephone, c.siret, c.adresse, c.site_web, c.note]
        .concat((c.forfaits || []).map(function (f) { return FORFAIT_LABEL[f.type] + ' ' + (f.libelle || ''); }))
        .filter(Boolean).join(' ').toLowerCase();
    %>
    <div class="list-row client-row" data-search="<%= recherche %>"
      style="align-items:center;gap:14px;cursor:pointer;" onclick="window.location='/clients/<%= c.id %>'">
      <div style="flex:1.6;min-width:150px;">
        <div style="font-size:13.5px;font-weight:700;"><%= titre %></div>
        <% if (sousTitre) { %><div style="font-size:12.5px;color:#9AA7B5;margin-top:2px;"><%= sousTitre %></div><% } %>
      </div>
      <div style="flex:1.2;min-width:150px;font-size:13px;color:#5B6B7D;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
        <% if (c.site_web) { %><%= c.site_web %><% } else if (c.email) { %><%= c.email %><% } else { %><span class="muted">—</span><% } %>
      </div>
      <div style="flex:1.4;min-width:150px;">
        <% if ((c.forfaits || []).length === 0) { %>
          <span class="muted" style="font-size:12.5px;">Aucun forfait</span>
        <% } else { %>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <% c.forfaits.forEach(function(f) { %>
              <span class="badge forfait-<%= f.type %>"><%= FORFAIT_LABEL[f.type] %><% if (f.libelle) { %> · <%= f.libelle %><% } %></span>
            <% }); %>
          </div>
        <% } %>
      </div>
      <% if (c.lienMainWP && c.mainwpConnecte !== false) { %>
        <a href="<%= c.lienMainWP %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline"
          style="padding:6px 10px;font-size:12.5px;flex-shrink:0;white-space:nowrap;" onclick="event.stopPropagation()"
          title="Connexion en 1 clic au wp-admin via MainWP">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px;"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          Connexion
        </a>
      <% } %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9AA7B5" stroke-width="2" style="flex-shrink:0;"><path d="M9 6l6 6-6 6"></path></svg>
    </div>
  <% }); %>
</div>

<% if (isAdmin) { %>
<div id="modal-client" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-box-header">
      <h3 style="margin:0;">Nouveau client</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-client').style.display='none'">✕</button>
    </div>
    <form method="POST" action="/clients">
      <label>Société</label>
      <input name="societe" placeholder="ex. Boulangerie Martin">
      <label>Client (contact)</label>
      <input name="client" placeholder="ex. Marie Martin">
      <label>Site web</label>
      <input name="site_web" placeholder="https://…">
      <label>Téléphone</label>
      <input name="telephone" placeholder="06 12 34 56 78">
      <label>E-mail</label>
      <input type="email" name="email" placeholder="contact@exemple.fr">
      <label>Siret</label>
      <input name="siret" placeholder="123 456 789 00012">
      <label>Adresse</label>
      <input name="adresse" placeholder="12 rue…, 75000 Paris">
      <label>Lien de connexion au site (admin)</label>
      <input name="lien_connexion" placeholder="https://…/wp-admin">
      <label>Note</label>
      <textarea name="note" rows="3" placeholder="Informations complémentaires…"></textarea>
      <p class="muted" style="font-size:12px;margin:2px 0 12px;">Les forfaits s'ajoutent ensuite depuis la fiche du client.</p>
      <button class="btn btn-primary" type="submit" style="width:100%;">Créer le client</button>
    </form>
  </div>
</div>
<% } %>

<script>
  // Recherche live : filtre les lignes déjà rendues (société, client, mail,
  // téléphone, siret, adresse, site, note, forfaits) sans rechargement.
  (function () {
    var input = document.getElementById('client-search');
    if (!input) return;
    var rows = Array.prototype.slice.call(document.querySelectorAll('.client-row'));
    var compteur = document.getElementById('client-count');
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var n = 0;
      rows.forEach(function (r) {
        var ok = (r.dataset.search || '').indexOf(q) !== -1;
        r.style.display = ok ? '' : 'none';
        if (ok) n++;
      });
      if (compteur) compteur.textContent = n;
    });
  })();

  window.ouvrirModalClient = function () {
    var modal = document.getElementById('modal-client');
    modal.querySelector('form').reset();
    modal.style.display = 'flex';
  };
</script>

<%- include('partials/footer') %>
