<%- include('partials/header', { title: 'Fiches de paie', active: 'paie' }) %>

<% if (locals.envoiEnvoye) { %><div class="success" style="background:#E2F3EB;color:#15784f;padding:12px 16px;border-radius:10px;font-size:13.5px;font-weight:600;margin-bottom:18px;">E-mail comptable envoyé avec succès.</div><% } %>
<% if (locals.envoiErreur) { %><div class="error"><%= envoiErreur %></div><% } %>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
    <h3 style="margin:0;">Dépôts récents</h3>
    <div style="display:flex;gap:10px;">
      <button type="button" class="btn btn-outline" onclick="document.getElementById('modal-envoi-comptable').style.display='flex'">Envoi comptable</button>
      <button type="button" class="btn btn-primary" onclick="document.getElementById('modal-ajouter-paie').style.display='flex'">+ Ajouter</button>
    </div>
  </div>
  <% if (recent.length === 0) { %>
    <div class="empty-state">Aucun dépôt pour l'instant.</div>
  <% } else { %>
    <% recent.forEach(function(p) { %>
      <div class="list-row">
        <div class="avatar" style="background:<%= p.profiles.avatar_color %>;">
          <%= (p.profiles.prenom[0] + p.profiles.nom[0]).toUpperCase() %>
        </div>
        <div style="flex:1;">
          <div style="font-size:13.5px;font-weight:600;"><%= p.profiles.prenom %> <%= p.profiles.nom %></div>
          <div style="font-size:12px;color:#9AA7B5;"><%= formatPeriode(p.periode) %></div>
        </div>
        <div style="font-size:12px;color:#9AA7B5;">Déposé le <%= formatDate(p.date_depot) %></div>
      </div>
    <% }); %>
  <% } %>
</div>

<div id="modal-ajouter-paie" class="modal-overlay" style="display:<%= error ? 'flex' : 'none' %>;">
  <div class="modal-box">
    <div class="modal-box-header">
      <h3 style="margin:0;">Déposer une fiche de paie</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-ajouter-paie').style.display='none'">✕</button>
    </div>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="POST" action="/paie" enctype="multipart/form-data">
      <label>Alternant</label>
      <%- include('partials/select-field', { name: 'alternant_id', options: alternants.map(a => ({ value: a.id, label: a.prenom + ' ' + a.nom })) }) %>
      <label>Période (mois)</label>
      <%- include('partials/month-input', { name: 'periode' }) %>
      <div class="upload-zone">
        <input type="file" name="fichier" accept="application/pdf" required>
        <span>PDF, max 5 Mo</span>
      </div>
      <button class="btn btn-primary" type="submit" style="width:100%;">Déposer et notifier</button>
    </form>
  </div>
</div>

<div id="modal-envoi-comptable" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-box-header">
      <h3 style="margin:0;">Envoi comptable</h3>
      <button type="button" class="modal-close" onclick="document.getElementById('modal-envoi-comptable').style.display='none'">✕</button>
    </div>
    <p style="font-size:12.5px;color:#9AA7B5;margin:0 0 16px;">
      Pour chaque société, un e-mail récapitulatif est préparé pour tous ses alternants (jours entreprise/école, congés payés pris, absences école). Vous pourrez relire et modifier chaque e-mail avant l'envoi.
    </p>
    <form method="POST" action="/envoi-comptable/generer">
      <label>Mois</label>
      <%- include('partials/month-input', { name: 'mois' }) %>
      <label>Société</label>
      <%- include('partials/select-field', {
        name: 'societe_id', placeholder: 'Toutes les sociétés',
        options: [{ value: '', label: 'Toutes les sociétés' }].concat(societes.map(s => ({ value: s.id, label: s.nom }))) }) %>
      <button class="btn btn-primary" type="submit" style="width:100%;margin-top:14px;">Générer les e-mails</button>
    </form>
    <% if (societes.length === 0) { %>
      <p class="muted" style="font-size:12.5px;margin-top:12px;">Aucune société n'a encore été créée. Rendez-vous dans <a href="/parametres">Paramètres</a> pour en ajouter une et renseigner son e-mail comptable.</p>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
