<%- include('partials/header', { title: 'Tableau de bord', active: 'dashboard' }) %>

<% const TACHE_LABEL = { a_faire: 'À faire', en_cours: 'En cours', termine: 'Terminé' };
   const TACHE_BADGE = { a_faire: 'badge-afaire', en_cours: 'badge-encours', termine: 'badge-termine' }; %>

<h2>Bonjour <%= profile.prenom %> 👋</h2>

<div class="<%= profile.heures_eligible ? 'grid-4' : 'grid-3' %>">
  <a href="/conges" class="card" style="display:block;">
    <div class="stat-label">Congés disponibles</div>
    <div class="stat-value" style="color:<%= dispo < 0 ? '#C2502E' : '#1F9D6B' %>;"><%= dispo %> j</div>
  </a>
  <a href="/tickets" class="card" style="display:block;">
    <div class="stat-label">Mes tickets ouverts</div>
    <div class="stat-value" style="color:#C2502E;"><%= mesTickets.length %></div>
  </a>
  <a href="/conges" class="card" style="display:block;">
    <div class="stat-label">Demandes en attente</div>
    <div class="stat-value" style="color:#B7791F;"><%= enAttente %></div>
  </a>
  <% if (profile.heures_eligible) { %>
    <a href="/heures" class="card" style="display:block;">
      <div class="stat-label">Heures supp. cumulées</div>
      <div class="stat-value" style="color:#7A53C1;"><%= totalHeures %> h</div>
    </a>
  <% } %>
</div>

<div class="grid-14">
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <h3 style="margin:0;">Mes tickets</h3>
      <a href="/tickets" class="btn btn-outline">Voir tout</a>
    </div>
    <% if (mesTickets.length === 0) { %>
      <p style="color:#9AA7B5;">Aucun ticket en cours. 🎉</p>
    <% } else { %>
      <% mesTickets.slice(0, 6).forEach(function(t) { %>
        <div class="list-row" style="gap:12px;">
          <span class="badge <%= PRIORITE_BADGE[t.priorite] %>"><%= PRIORITE_LABEL[t.priorite] %></span>
          <div style="flex:1;font-size:13px;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= t.titre %></div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <h3 style="margin:0;">Mes tâches à faire</h3>
      <a href="/projets?vue=taches" class="btn btn-outline">Voir tout</a>
    </div>
    <% if (mesTaches.length === 0) { %>
      <p style="color:#9AA7B5;">Aucune tâche en cours.</p>
    <% } else { %>
      <% mesTaches.slice(0, 6).forEach(function(t) { %>
        <div class="list-row" style="gap:12px;">
          <div style="flex:1;min-width:0;">
            <div style="font-size:13px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= t.titre %></div>
            <div style="font-size:11.5px;color:#9AA7B5;"><%= t.projets ? t.projets.nom : '' %></div>
          </div>
          <span class="badge <%= TACHE_BADGE[t.statut] %>"><%= TACHE_LABEL[t.statut] %></span>
        </div>
      <% }); %>
    <% } %>
  </div>
</div>

<div class="grid-14">
  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <h3 style="margin:0;">Mes projets actifs</h3>
      <a href="/projets" class="btn btn-outline">Voir tout</a>
    </div>
    <% if (mesProjets.length === 0) { %>
      <p style="color:#9AA7B5;">Aucun projet actif.</p>
    <% } else { %>
      <% mesProjets.slice(0, 6).forEach(function(p) { %>
        <div style="padding:10px 2px;border-bottom:1px solid #F1F4F8;">
          <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:600;margin-bottom:5px;">
            <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= p.nom %></span>
            <span style="color:#5B6B7D;"><%= p.nbTerminees %>/<%= p.nbTaches %> · <%= p.pct %>%</span>
          </div>
          <div class="progress-bar"><div style="width:<%= p.pct %>%;"></div></div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <div class="card">
    <h3>Mes prochaines semaines d'école</h3>
    <% if (mesSemainesEcole.length === 0) { %>
      <p style="color:#9AA7B5;">Aucune semaine d'école à venir.</p>
    <% } else { %>
      <% mesSemainesEcole.forEach(function(s) { %>
        <div class="list-row" style="gap:10px;">
          <span class="type-dot dot-ecole" style="margin:0;"></span>
          <div style="flex:1;font-size:13px;font-weight:600;">Semaine du <%= formatDate(s.lundi) %></div>
        </div>
      <% }); %>
    <% } %>
    <% if (derniereFiche) { %>
      <div class="row-flex" style="margin-top:14px;padding:12px 14px;border:1px solid #EDF0F4;border-radius:12px;gap:12px;">
        <div style="flex:1;">
          <div style="font-size:12px;color:#9AA7B5;">Dernière fiche de paie</div>
          <div style="font-size:14px;font-weight:700;"><%= formatPeriode(derniereFiche.periode) %></div>
        </div>
        <a href="/paie/<%= derniereFiche.id %>/telecharger" class="btn btn-outline">Télécharger</a>
      </div>
    <% } %>
  </div>
</div>

<div class="card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:14px;">
    <h3 style="margin:0;">Planning de l'équipe</h3>
    <div class="legend">
      <div class="legend-item"><span class="type-dot dot-entreprise"></span>Entreprise</div>
      <div class="legend-item"><span class="type-dot dot-ecole"></span>École</div>
      <div class="legend-item"><span class="type-dot dot-conge"></span>Congé / Récup.</div>
      <div class="legend-item"><span class="type-dot dot-absent"></span>Absent</div>
      <div class="legend-item"><span class="type-dot dot-ferie"></span>Férié</div>
    </div>
  </div>
  <% if (equipe.length === 0) { %>
    <div class="empty-state">Aucun alternant.</div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <div style="display:flex;margin-bottom:8px;padding-left:200px;gap:6px;min-width:600px;">
      <% equipeJours.forEach(function(j) { %>
        <div style="flex:1;text-align:center;">
          <div style="font-size:11px;color:#9AA7B5;font-weight:600;text-transform:uppercase;"><%= j.dow %></div>
          <div style="font-size:14px;font-weight:700;color:#5B6B7D;"><%= j.num %></div>
        </div>
      <% }); %>
    </div>
    <% equipe.forEach(function(a) { %>
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;min-width:600px;">
        <div style="width:200px;flex-shrink:0;" class="row-flex">
          <div class="avatar" style="background:<%= a.avatar_color %>;"><%= (a.prenom[0]+a.nom[0]).toUpperCase() %></div>
          <div style="min-width:0;overflow:hidden;">
            <div style="font-size:13.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= a.prenom %> <%= a.nom %></div>
            <div style="font-size:11.5px;color:#9AA7B5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= a.poste || '—' %></div>
          </div>
        </div>
        <% equipeJours.forEach(function(j) { %>
          <% const t = equipePlanningMap[a.id + j.iso]; %>
          <div class="<%= t ? 'type-'+t : '' %>" style="flex:1;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;<%= !t ? 'background:#F6F8FB;' : '' %>">
            <% if (t) { %><span class="type-dot dot-<%= t %>" style="margin:0;"></span><% } %>
          </div>
        <% }); %>
      </div>
    <% }); %>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
